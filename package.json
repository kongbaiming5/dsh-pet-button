{
  "name": "dsh-pet-button",
  "version": "0.1.0",
  "type": "module",
  "description": "桌宠开关：一键开/关桌面上的 dsh-pet 桌宠，Harness 关闭时还能顺手把它启动起来。A desktop switch for your dsh-pet pet, with one-click Harness launch.",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "author": "kongbaiming5",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "widget",
    "macos",
    "dsh-pet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongbaiming5/dsh-pet-button.git"
  },
  "homepage": "https://github.com/kongbaiming5/dsh-pet-button#readme",
  "bugs": {
    "url": "https://github.com/kongbaiming5/dsh-pet-button/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
